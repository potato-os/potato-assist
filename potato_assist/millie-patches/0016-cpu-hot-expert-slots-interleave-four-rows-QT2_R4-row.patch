From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: jan <1760229+slomin@users.noreply.github.com>
Date: Wed, 23 Sep 2026 01:07:34 +0100
Subject: [PATCH] cpu: hot-expert slots interleave four rows (QT2_R4), rows in
 the lanes (#190)

The ternary experts' one-token GEMV ran at 12 GB/s on five big cores: per
row it loads the activation, converts its scales and reduces across lanes.
QT2_R4 holds QT2_R's codes and scales with four rows interleaved, so one
16-byte load of codes feeds a by-lane sdot for four rows and the rows stay in
the lanes to the end; each column's sub-block sums and scales are prepared
once per call. The same integers and float operations in the GEMV's order
make every output bit-identical (test-millie-qt2r, both expert shapes, 1 to
512 columns, mul_mat and mul_mat_id). The cache repacks straight from the
file's QT_MS32K4, 0.16-0.28 ms per matrix on the 12R.

12R tg128, pinned, two interleaved rounds of three: 13.03 -> 14.14 tok/s.
LLAMA_HOT_R4=0 keeps QT2_R.

diff --git a/ggml/include/ggml.h b/ggml/include/ggml.h
index 3bf1314..b0064c9 100644
--- a/ggml/include/ggml.h
+++ b/ggml/include/ggml.h
@@ -444,7 +444,8 @@ extern "C" {
         GGML_TYPE_QT_MS32K4 = 57, // 1.6875 bpw: TERNARY (-1/0/+1), mask+sign coding, sub-block=32, 128 non-zeros per 256-weight block, 4-bit UNSIGNED sub-scales + fp16 super-scale per 8 subs
         GGML_TYPE_Q4_SYM16F = 58, // 4-bit symmetric, group=16, fp16 scale
         GGML_TYPE_QT2_R     = 59, // 2.1875 bpw: QT_MS32K4 repacked as 2-bit codes for the CPU; never in a file (#185)
-        GGML_TYPE_COUNT   = 60,
+        GGML_TYPE_QT2_R4    = 60, // QT2_R with four rows interleaved, the CPU's hot-expert slots; never in a file (#190)
+        GGML_TYPE_COUNT   = 61,
     };
 
     // precision
diff --git a/ggml/src/ggml-common.h b/ggml/src/ggml-common.h
index 0b0e293..2949909 100644
--- a/ggml/src/ggml-common.h
+++ b/ggml/src/ggml-common.h
@@ -286,6 +286,19 @@ typedef struct {
 } block_qt2_r;
 static_assert(sizeof(block_qt2_r) == sizeof(ggml_half) + QKT_MS32K_SUPER/2 + QKT_MS32K/4, "wrong qt2_r block size/padding");
 
+// QT2_R4 (#190): QT2_R with four rows interleaved, so the CPU's one-token GEMV
+// keeps the rows in the lanes. A block holds the same 256 columns of rows
+// 4g..4g+3: the super-scales, the sub-scale bytes as [pair][row], and per sub
+// and half (16 weights) 16 bytes where byte 4*row + k holds, at bits 2s, the
+// code of weight 16*half + 4s + k. A row's share is one QT2_R block, so row
+// sizes match QT2_R; a tensor's row count must be a multiple of four.
+typedef struct {
+    ggml_half d[4];
+    uint8_t   scales[4 * QKT_MS32K_SUPER / 2];
+    uint8_t   qs[4 * QKT_MS32K / 4];
+} block_qt2_r4;
+static_assert(sizeof(block_qt2_r4) == 4 * sizeof(block_qt2_r), "wrong qt2_r4 block size/padding");
+
 // Q4_SYM16K: 4-bit symmetric K-scale type. 8 sub-blocks of 16 (NOT 32);
 // nibble order is PAIRWISE: byte j of a sub-block holds elements 2j (low
 // nibble) and 2j+1 (high). value = (code - 7.5) * d * scales[s] (int8 sub-scales).
diff --git a/ggml/src/ggml-cpu/arch/arm/quants.c b/ggml/src/ggml-cpu/arch/arm/quants.c
index 1481e72..9e328ee 100644
--- a/ggml/src/ggml-cpu/arch/arm/quants.c
+++ b/ggml/src/ggml-cpu/arch/arm/quants.c
@@ -891,6 +891,111 @@ void ggml_gemm_qt2_r_q8_0(int n, int nr, int nc, const void * vx, size_t bx, con
     millie_gemm(millie_tiles_qt2, v >> 4, v & 15, n / QKT_MS32K, nr, nc, vx, bx, vy, dst);
 }
 
+
+// #190: QT2_R4 (four rows interleaved) at one or more columns. The rows stay
+// in the lanes: one 16-byte load of codes feeds by-lane sdots for four rows,
+// and each column's sub-block sums and scales are prepared once per call.
+// Per (row, column) it is ggml_vec_dot_qt2_r_q8_0's arithmetic in its order:
+// the same integer dots (codes against the column, minus the column's sum),
+// then per sub t the fused sc*d8 products, (0+1)+(2+3), and d times that into
+// the running sum; so every output is bit-identical to the GEMV and the tiles.
+#define QT2_R4_MAX_NB 32
+#define QT2_R4_NC     4
+
+typedef struct {
+    int32_t nys[QT2_R4_MAX_NB * QKT_MS32K_SUPER]; // minus each sub's sum of the Q8_0 values
+    float   d8 [QT2_R4_MAX_NB * QKT_MS32K_SUPER];
+} qt2_r4_col;
+
+static void qt2_r4_prep(const block_q8_0 * GGML_RESTRICT y, int nb, qt2_r4_col * GGML_RESTRICT p) {
+    const int8x16_t ones = vdupq_n_s8(1);
+    for (int j = 0; j < nb * QKT_MS32K_SUPER; ++j) {
+        const int32x4_t s = ggml_vdotq_s32(ggml_vdotq_s32(vdupq_n_s32(0), vld1q_s8(y[j].qs), ones), vld1q_s8(y[j].qs + 16), ones);
+        p->nys[j] = -vaddvq_s32(s);
+        p->d8[j]  = GGML_CPU_FP16_TO_FP32(y[j].d);
+    }
+}
+
+static inline __attribute__((always_inline)) void qt2_r4_group(
+        const int NC, const int nb, const block_qt2_r4 * GGML_RESTRICT x,
+        const block_q8_0 * const * GGML_RESTRICT ys, const qt2_r4_col * GGML_RESTRICT ps, float32x4_t * GGML_RESTRICT out) {
+    const uint8x16_t m3 = vdupq_n_u8(3), mC = vdupq_n_u8(0x0C), m30 = vdupq_n_u8(0x30), m15 = vdupq_n_u8(15);
+    const float32x4_t z = vdupq_n_f32(0.0f);
+    float32x4_t sum[QT2_R4_NC];
+    for (int c = 0; c < NC; ++c) sum[c] = z;
+    for (int i = 0; i < nb; ++i) {
+        const block_qt2_r4 * GGML_RESTRICT b = x + i;
+        const float32x4_t dv = vcvt_f32_f16(vreinterpret_f16_u16(vld1_u16((const uint16_t *) b->d)));
+        const uint8x16_t S = vld1q_u8(b->scales);
+        const uint8x16_t Slo = vandq_u8(S, m15), Shi = vshrq_n_u8(S, 4);
+        const uint16x8_t lo0 = vmovl_u8(vget_low_u8(Slo)), lo1 = vmovl_high_u8(Slo);
+        const uint16x8_t hi0 = vmovl_u8(vget_low_u8(Shi)), hi1 = vmovl_high_u8(Shi);
+        // sub 2j is the low nibble of bytes 4j..4j+3, sub 2j+1 the high one
+        float32x4_t sc[QKT_MS32K_SUPER];
+        sc[0] = vcvtq_f32_u32(vmovl_u16(vget_low_u16(lo0))); sc[1] = vcvtq_f32_u32(vmovl_u16(vget_low_u16(hi0)));
+        sc[2] = vcvtq_f32_u32(vmovl_high_u16(lo0));          sc[3] = vcvtq_f32_u32(vmovl_high_u16(hi0));
+        sc[4] = vcvtq_f32_u32(vmovl_u16(vget_low_u16(lo1))); sc[5] = vcvtq_f32_u32(vmovl_u16(vget_low_u16(hi1)));
+        sc[6] = vcvtq_f32_u32(vmovl_high_u16(lo1));          sc[7] = vcvtq_f32_u32(vmovl_high_u16(hi1));
+        float32x4_t a[QT2_R4_NC][4];
+        for (int sb = 0; sb < QKT_MS32K_SUPER; ++sb) {
+            const uint8x16_t Q0 = vld1q_u8(b->qs + 32*sb), Q1 = vld1q_u8(b->qs + 32*sb + 16);
+            // shifts 0 and 3 as codes; 1 and 2 masked in place (x4, x16), folded back below
+            const int8x16_t w0 = vreinterpretq_s8_u8(vandq_u8(Q0, m3)),  w3 = vreinterpretq_s8_u8(vshrq_n_u8(Q0, 6));
+            const int8x16_t w1 = vreinterpretq_s8_u8(vandq_u8(Q0, mC)),  w2 = vreinterpretq_s8_u8(vandq_u8(Q0, m30));
+            const int8x16_t v0 = vreinterpretq_s8_u8(vandq_u8(Q1, m3)),  v3 = vreinterpretq_s8_u8(vshrq_n_u8(Q1, 6));
+            const int8x16_t v1 = vreinterpretq_s8_u8(vandq_u8(Q1, mC)),  v2 = vreinterpretq_s8_u8(vandq_u8(Q1, m30));
+            for (int c = 0; c < NC; ++c) {
+                const block_q8_0 * GGML_RESTRICT yb = ys[c] + i*QKT_MS32K_SUPER + sb;
+                const int8x16_t Y0 = vld1q_s8(yb->qs), Y1 = vld1q_s8(yb->qs + 16);
+                int32x4_t s0 = vld1q_dup_s32(&ps[c].nys[i*QKT_MS32K_SUPER + sb]);
+                s0 = vdotq_laneq_s32(s0, w0, Y0, 0);
+                s0 = vdotq_laneq_s32(s0, w3, Y0, 3);
+                s0 = vdotq_laneq_s32(s0, v0, Y1, 0);
+                s0 = vdotq_laneq_s32(s0, v3, Y1, 3);
+                int32x4_t s1 = vdotq_laneq_s32(vdupq_n_s32(0), w1, Y0, 1);
+                s1 = vdotq_laneq_s32(s1, v1, Y1, 1);
+                int32x4_t s2 = vdotq_laneq_s32(vdupq_n_s32(0), w2, Y0, 2);
+                s2 = vdotq_laneq_s32(s2, v2, Y1, 2);
+                s0 = vsraq_n_s32(s0, s1, 2);
+                s0 = vsraq_n_s32(s0, s2, 4);
+                const float32x4_t g = vcvtq_f32_s32(s0);
+                const float32x4_t p = vmulq_n_f32(sc[sb], ps[c].d8[i*QKT_MS32K_SUPER + sb]);
+                a[c][sb & 3] = vfmaq_f32(sb < 4 ? z : a[c][sb & 3], g, p);
+            }
+        }
+        for (int c = 0; c < NC; ++c) {
+            sum[c] = vfmaq_f32(sum[c], dv, vaddq_f32(vaddq_f32(a[c][0], a[c][1]), vaddq_f32(a[c][2], a[c][3])));
+        }
+    }
+    for (int c = 0; c < NC; ++c) out[c] = sum[c];
+}
+
+#define QT2_R4_GROUP_FN(NC) \
+    static void qt2_r4_group_##NC(int nb, const block_qt2_r4 * x, const block_q8_0 * const * ys, const qt2_r4_col * ps, float32x4_t * out) { \
+        qt2_r4_group(NC, nb, x, ys, ps, out); \
+    }
+QT2_R4_GROUP_FN(1) QT2_R4_GROUP_FN(2) QT2_R4_GROUP_FN(3) QT2_R4_GROUP_FN(4)
+
+// nr rows from row 0 of vx (a multiple of four), nc columns; dst[c][r] as the tiles do.
+void ggml_gemm_qt2_r4_q8_0(int n, int nr, int nc, const void * vx, size_t bx, const void * const * vy, float * const * dst) {
+    UNUSED(bx);
+    typedef void (*group_fn)(int, const block_qt2_r4 *, const block_q8_0 * const *, const qt2_r4_col *, float32x4_t *);
+    static const group_fn groups[QT2_R4_NC] = { qt2_r4_group_1, qt2_r4_group_2, qt2_r4_group_3, qt2_r4_group_4 };
+    const int nb = n / QKT_MS32K;
+    GGML_ASSERT(nb <= QT2_R4_MAX_NB && nr % 4 == 0);
+    const block_q8_0 * const * ys = (const block_q8_0 * const *) vy;
+    qt2_r4_col ps[QT2_R4_NC];
+    for (int c0 = 0; c0 < nc; c0 += QT2_R4_NC) {
+        const int kc = nc - c0 < QT2_R4_NC ? nc - c0 : QT2_R4_NC;
+        for (int c = 0; c < kc; ++c) qt2_r4_prep(ys[c0 + c], nb, &ps[c]);
+        for (int g = 0; g < nr / 4; ++g) {
+            float32x4_t out[QT2_R4_NC];
+            groups[kc - 1](nb, (const block_qt2_r4 *) vx + (size_t) g * nb, ys + c0, ps, out);
+            for (int c = 0; c < kc; ++c) vst1q_f32(dst[c0 + c] + 4*g, out[c]);
+        }
+    }
+}
+
 // #185: Q4_SYM16K rows interleaved by four (the CPU repack buffer). A block
 // holds the same 128 columns of four rows: super-scales, sub-scales as
 // [sub][row], nibbles as [sub][half][row][4 bytes], so one 16-byte load feeds
diff --git a/ggml/src/ggml-cpu/ggml-cpu.c b/ggml/src/ggml-cpu/ggml-cpu.c
index 2ed86d5..15504e8 100644
--- a/ggml/src/ggml-cpu/ggml-cpu.c
+++ b/ggml/src/ggml-cpu/ggml-cpu.c
@@ -270,6 +270,11 @@ static const struct ggml_type_traits_cpu type_traits_cpu[GGML_TYPE_COUNT] = {
         .vec_dot_type             = GGML_TYPE_Q8_0,
         .nrows                    = 1,
     },
+    [GGML_TYPE_QT2_R4] = {
+        .vec_dot                  = ggml_vec_dot_qt2_r4_q8_0,
+        .vec_dot_type             = GGML_TYPE_Q8_0,
+        .nrows                    = 1,
+    },
     [GGML_TYPE_Q1_SYM32K] = {
         .from_float               = quantize_row_q1_sym32k,
         .vec_dot                  = ggml_vec_dot_q1_sym32k_q8_0,
@@ -1231,6 +1236,9 @@ static ggml_gemm_tile_t ggml_cpu_gemm_tile(enum ggml_type type, enum ggml_type v
     if (vec_dot_type != GGML_TYPE_Q8_0) {
         return NULL;
     }
+    if (type == GGML_TYPE_QT2_R4) {
+        return ggml_gemm_qt2_r4_q8_0;
+    }
     // At one column only the 4-bit type beats its GEMV: the ternary tiles pay
     // for a decode they cannot amortise (#185).
     if (single_column && type != GGML_TYPE_Q4_SYM16K) {
@@ -1519,8 +1527,11 @@ UseGgmlGemm2:;
         nchunk1 = nr0 > nr1 ? 1 : nth; // parallelize by src1 rows
     }
 
-    // The number of elements in each chunk
-    const int64_t dr0 = (nr0 + nchunk0 - 1) / nchunk0;
+    // The number of elements in each chunk; QT2_R4 rows come in fours (#190)
+    int64_t dr0 = (nr0 + nchunk0 - 1) / nchunk0;
+    if (src0->type == GGML_TYPE_QT2_R4) {
+        dr0 = (dr0 + 3) / 4 * 4;
+    }
     const int64_t dr1 = (nr1 + nchunk1 - 1) / nchunk1;
 
     // The first chunk comes from our thread_id, the rest will get auto-assigned.
@@ -1801,7 +1812,10 @@ static void ggml_compute_forward_mul_mat_id(
             nchunk1 = nr0 > nr1 ? 1 : nth;
         }
 
-        const int64_t dr0 = (nr0 + nchunk0 - 1) / nchunk0;
+        int64_t dr0 = (nr0 + nchunk0 - 1) / nchunk0;
+        if (type == GGML_TYPE_QT2_R4) {
+            dr0 = (dr0 + 3) / 4 * 4; // #190: rows come in fours
+        }
         const int64_t dr1 = (nr1 + nchunk1 - 1) / nchunk1;
 
         int current_chunk = ith;
diff --git a/ggml/src/ggml-cpu/quants.c b/ggml/src/ggml-cpu/quants.c
index 78959ea..5458d76 100644
--- a/ggml/src/ggml-cpu/quants.c
+++ b/ggml/src/ggml-cpu/quants.c
@@ -403,6 +403,13 @@ void ggml_vec_dot_qt2_r_q8_0_generic(int n, float * GGML_RESTRICT s, size_t bs,
     *s = sumf;
 }
 
+// #190: a QT2_R4 row is not addressable on its own; mul_mat and mul_mat_id
+// take ggml_gemm_qt2_r4_q8_0 for this type at every column count.
+void ggml_vec_dot_qt2_r4_q8_0(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, const void * GGML_RESTRICT vy, size_t by, int nrc) {
+    UNUSED(n); UNUSED(s); UNUSED(bs); UNUSED(vx); UNUSED(bx); UNUSED(vy); UNUSED(by); UNUSED(nrc);
+    GGML_ABORT("QT2_R4 has no row dot product");
+}
+
 void ggml_vec_dot_q1_sym32k_q8_0_generic(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, const void * GGML_RESTRICT vy, size_t by, int nrc) {
     assert(n % QK1_SYM32K == 0);
     assert(nrc == 1);
diff --git a/ggml/src/ggml-cpu/quants.h b/ggml/src/ggml-cpu/quants.h
index a516f87..dc5e311 100644
--- a/ggml/src/ggml-cpu/quants.h
+++ b/ggml/src/ggml-cpu/quants.h
@@ -68,6 +68,9 @@ int  ggml_gemm_qt_ms32k4_q8_0_enabled(void);
 void ggml_gemm_q4_sym16k_q8_0(int n, int nr, int nc, const void * vx, size_t bx, const void * const * vy, float * const * dst);
 void ggml_gemm_qt_ms32k4_q8_0(int n, int nr, int nc, const void * vx, size_t bx, const void * const * vy, float * const * dst);
 void ggml_gemm_qt2_r_q8_0(int n, int nr, int nc, const void * vx, size_t bx, const void * const * vy, float * const * dst);
+// #190: QT2_R4, four rows interleaved; nr % 4 == 0 and vx at a multiple-of-four row.
+void ggml_gemm_qt2_r4_q8_0(int n, int nr, int nc, const void * vx, size_t bx, const void * const * vy, float * const * dst);
+void ggml_vec_dot_qt2_r4_q8_0(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, const void * GGML_RESTRICT vy, size_t by, int nrc);
 
 // #185: Q4_SYM16K rows interleaved by four (CPU repack buffer); bit-identical to ggml_vec_dot_q4_sym16k_q8_0.
 int    ggml_q4_sym16k_x4_enabled(void);
diff --git a/ggml/src/ggml-quants.c b/ggml/src/ggml-quants.c
index 2727d30..dc2ca2a 100644
--- a/ggml/src/ggml-quants.c
+++ b/ggml/src/ggml-quants.c
@@ -1244,6 +1244,131 @@ void ggml_repack_qt_ms32k4_qt2_r(const block_qt_ms32k4 * GGML_RESTRICT x, block_
     }
 }
 
+// #190: four QT2_R rows into QT2_R4. Per sub and half, row r's 16 codes (index
+// 4s + k) sit at one shift in 16 source bytes; a 4 x 4 transpose of 32-bit
+// lanes puts each row's four-byte group k-major, and s becomes the shift.
+static void qt2_r4_pack(const uint8_t codes[4][QKT_MS32K], block_qt2_r4 * GGML_RESTRICT o) {
+#if defined(__ARM_NEON)
+    for (int sb = 0; sb < QKT_MS32K_SUPER; ++sb) {
+        for (int h = 0; h < 2; ++h) {
+            const uint32x4_t A = vreinterpretq_u32_u8(vld1q_u8(codes[0] + 32*sb + 16*h));
+            const uint32x4_t B = vreinterpretq_u32_u8(vld1q_u8(codes[1] + 32*sb + 16*h));
+            const uint32x4_t C = vreinterpretq_u32_u8(vld1q_u8(codes[2] + 32*sb + 16*h));
+            const uint32x4_t D = vreinterpretq_u32_u8(vld1q_u8(codes[3] + 32*sb + 16*h));
+            const uint64x2_t T0 = vreinterpretq_u64_u32(vtrn1q_u32(A, B)), T1 = vreinterpretq_u64_u32(vtrn2q_u32(A, B));
+            const uint64x2_t T2 = vreinterpretq_u64_u32(vtrn1q_u32(C, D)), T3 = vreinterpretq_u64_u32(vtrn2q_u32(C, D));
+            const uint32x4_t s0 = vreinterpretq_u32_u64(vtrn1q_u64(T0, T2)), s1 = vreinterpretq_u32_u64(vtrn1q_u64(T1, T3));
+            const uint32x4_t s2 = vreinterpretq_u32_u64(vtrn2q_u64(T0, T2)), s3 = vreinterpretq_u32_u64(vtrn2q_u64(T1, T3));
+            const uint32x4_t v = vorrq_u32(vorrq_u32(s0, vshlq_n_u32(s1, 2)), vorrq_u32(vshlq_n_u32(s2, 4), vshlq_n_u32(s3, 6)));
+            vst1q_u8(o->qs + 32*sb + 16*h, vreinterpretq_u8_u32(v));
+        }
+    }
+#else
+    memset(o->qs, 0, sizeof(o->qs));
+    for (int r = 0; r < 4; ++r) {
+        for (int e = 0; e < QKT_MS32K; ++e) {
+            const int sb = e / 32, w = e % 32, h = w / 16, s = (w % 16) / 4, k = w % 4;
+            o->qs[32*sb + 16*h + 4*r + k] |= (uint8_t) (codes[r][e] << (2*s));
+        }
+    }
+#endif
+}
+
+static void qt2_r4_heads(const ggml_half d[4], const uint8_t scales[4][QKT_MS32K_SUPER / 2], block_qt2_r4 * GGML_RESTRICT o) {
+    for (int r = 0; r < 4; ++r) {
+        o->d[r] = d[r];
+        for (int j = 0; j < QKT_MS32K_SUPER / 2; ++j) {
+            o->scales[4*j + r] = scales[r][j];
+        }
+    }
+}
+
+void ggml_repack_qt2_r_qt2_r4(const block_qt2_r * GGML_RESTRICT x, block_qt2_r4 * GGML_RESTRICT y, int64_t nrows, int64_t nb) {
+    assert(nrows % 4 == 0);
+    uint8_t   codes[4][QKT_MS32K];
+    ggml_half d[4];
+    uint8_t   scales[4][QKT_MS32K_SUPER / 2];
+    for (int64_t g = 0; g < nrows / 4; ++g) {
+        for (int64_t i = 0; i < nb; ++i) {
+            for (int r = 0; r < 4; ++r) {
+                const block_qt2_r * b = x + (4*g + r)*nb + i;
+                d[r] = b->d;
+                memcpy(scales[r], b->scales, sizeof(scales[r]));
+                for (int e = 0; e < QKT_MS32K; ++e) {
