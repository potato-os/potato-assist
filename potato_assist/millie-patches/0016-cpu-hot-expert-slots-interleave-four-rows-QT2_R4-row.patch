+void ggml_repack_qt_ms32k4_qt2_r4(const block_qt_ms32k4 * GGML_RESTRICT x, block_qt2_r4 * GGML_RESTRICT y, int64_t nrows, int64_t nb) {
+    assert(nrows % 4 == 0);
+    uint8_t   codes[4][QKT_MS32K];
+    ggml_half d[4];
+    uint8_t   scales[4][QKT_MS32K_SUPER / 2];
+    for (int64_t g = 0; g < nrows / 4; ++g) {
+        for (int64_t i = 0; i < nb; ++i) {
+            for (int r = 0; r < 4; ++r) {
+                const block_qt_ms32k4 * b = x + (4*g + r)*nb + i;
+                d[r] = b->d;
+                memcpy(scales[r], b->scales, sizeof(scales[r]));
+#if defined(__ARM_NEON)
+                // QT2_R's decode, stored as codes in element order.
+                uint64_t s_lo, s_hi;
+                memcpy(&s_lo, b->signs,     8);
+                memcpy(&s_hi, b->signs + 8, 8);
+                unsigned start = 0;
+                const int8x16_t one = vdupq_n_s8(1);
+                for (int sb = 0; sb < QKT_MS32K_SUPER; ++sb) {
+                    uint32_t m;
+                    memcpy(&m, b->mask + 4*sb, 4);
+                    int8x16_t q0 = vdupq_n_s8(0), q1 = vdupq_n_s8(0);
+                    if (m != 0) {
+                        const uint32_t win = (uint32_t)(start < 64
