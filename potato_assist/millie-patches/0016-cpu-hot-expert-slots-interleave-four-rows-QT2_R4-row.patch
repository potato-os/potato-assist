+                        const uint32_t mA = m & 0xff, mB = (m >> 8) & 0xff, mC = (m >> 16) & 0xff, mD = m >> 24;
+                        const uint32_t counts = vget_lane_u32(vreinterpret_u32_u8(vcnt_u8(vcreate_u8(m))), 0) * 0x01010101u;
+                        const uint8_t w0 = (uint8_t)win;
+                        const uint8_t w1 = (uint8_t)(win >> (counts & 255));
+                        const uint8_t w2 = (uint8_t)(win >> ((counts >> 8) & 255));
+                        const uint8_t w3 = (uint8_t)(win >> ((counts >> 16) & 255));
+                        const uint8x16_t winv0 = vcombine_u8(vdup_n_u8(w0), vdup_n_u8(w1));
+                        const uint8x16_t winv1 = vcombine_u8(vdup_n_u8(w2), vdup_n_u8(w3));
+                        const uint8x16_t P0 = vcombine_u8(vcreate_u8(qt2_sign_bit[mA]), vcreate_u8(qt2_sign_bit[mB]));
+                        const uint8x16_t P1 = vcombine_u8(vcreate_u8(qt2_sign_bit[mC]), vcreate_u8(qt2_sign_bit[mD]));
+                        const uint8x16_t mFF0 = vtstq_u8(P0, P0);
+                        const uint8x16_t mFF1 = vtstq_u8(P1, P1);
+                        const uint8x16_t sFF0 = vtstq_u8(winv0, P0);
+                        const uint8x16_t sFF1 = vtstq_u8(winv1, P1);
