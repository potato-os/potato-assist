@@ -0,0 +1,101 @@
+// #185: QT2_R (QT_MS32K4 repacked as 2-bit codes) must give the CPU backend
+// the same bytes as the original: dequantization, mul_mat at every column
+// count (GEMV and tiles) and mul_mat_id at Millie's expert shape.
+#include "ggml.h"
+#include "ggml-cpu.h"
+#include "../ggml/src/ggml-quants.h"
+
+#include <cstdio>
+#include <algorithm>
+#include <cstring>
+#include <random>
+#include <vector>
+
+static void fill_random(float * x, size_t n, std::mt19937 & rng) {
+    std::normal_distribution<float> dist(0.0f, 1.0f);
+    for (size_t i = 0; i < n; ++i) x[i] = dist(rng);
+}
+
+static bool same(const ggml_tensor * a, const ggml_tensor * b, const char * what) {
+    const bool ok = ggml_nbytes(a) == ggml_nbytes(b) && memcmp(a->data, b->data, ggml_nbytes(a)) == 0;
+    printf("%-44s %s\n", what, ok ? "identical" : "DIFFERS");
+    return ok;
+}
+
+int main() {
+    std::mt19937 rng(185);
+    const int64_t K = 2048, M = 512, E = 16, USED = 4;
+    ggml_init_params params = { size_t(1) << 30, nullptr, false };
+    ggml_context * ctx = ggml_init(params);
+    bool ok = true;
+
+    // One expert stack in both layouts.
+    std::vector<float> w(K * M * E);
+    fill_random(w.data(), w.size(), rng);
+    ggml_tensor * a0 = ggml_new_tensor_3d(ctx, GGML_TYPE_QT_MS32K4, K, M, E);
+    ggml_tensor * a1 = ggml_new_tensor_3d(ctx, GGML_TYPE_QT2_R, K, M, E);
+    ggml_quantize_chunk(GGML_TYPE_QT_MS32K4, w.data(), a0->data, 0, M * E, K, nullptr);
+    ggml_repack_qt_ms32k4_qt2_r((const block_qt_ms32k4 *) a0->data, (block_qt2_r *) a1->data, K * M * E / 256);
+
+    std::vector<float> d0(K * M), d1(K * M);
+    dequantize_row_qt_ms32k4((const block_qt_ms32k4 *) a0->data, d0.data(), K * M);
+    dequantize_row_qt2_r((const block_qt2_r *) a1->data, d1.data(), K * M);
+    const bool deq = memcmp(d0.data(), d1.data(), d0.size() * sizeof(float)) == 0;
+    printf("%-44s %s\n", "dequantize", deq ? "identical" : "DIFFERS");
+    ok &= deq;
+
+    ggml_tensor * m0 = ggml_view_2d(ctx, a0, K, M, a0->nb[1], 0);
+    ggml_tensor * m1 = ggml_view_2d(ctx, a1, K, M, a1->nb[1], 0);
+    for (int64_t n : { 1, 2, 3, 5, 8, 17, 64, 512 }) {
+        ggml_tensor * b = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, K, n);
+        fill_random((float *) b->data, K * n, rng);
+        ggml_tensor * c0 = ggml_mul_mat(ctx, m0, b);
+        ggml_tensor * c1 = ggml_mul_mat(ctx, m1, b);
+        ggml_cgraph * gf = ggml_new_graph(ctx);
+        ggml_build_forward_expand(gf, c0);
+        ggml_build_forward_expand(gf, c1);
+        ggml_graph_compute_with_ctx(ctx, gf, 4);
+        char what[64];
+        snprintf(what, sizeof(what), "mul_mat n=%lld", (long long) n);
+        ok &= same(c0, c1, what);
+    }
+
+    for (int64_t n : { 1, 7, 64, 512 }) {
+        ggml_tensor * b   = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, K, 1, n);
+        ggml_tensor * ids = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, USED, n);
+        fill_random((float *) b->data, K * n, rng);
+        for (int64_t t = 0; t < n; ++t) {
+            std::vector<int> perm(E);
+            for (int e = 0; e < E; ++e) perm[e] = e;
+            std::shuffle(perm.begin(), perm.end(), rng);
+            for (int u = 0; u < USED; ++u) ((int32_t *) ids->data)[t * USED + u] = perm[u];
+        }
+        ggml_tensor * c0 = ggml_mul_mat_id(ctx, a0, b, ids);
+        ggml_tensor * c1 = ggml_mul_mat_id(ctx, a1, b, ids);
+        ggml_cgraph * gf = ggml_new_graph(ctx);
+        ggml_build_forward_expand(gf, c0);
+        ggml_build_forward_expand(gf, c1);
+        ggml_graph_compute_with_ctx(ctx, gf, 4);
+        char what[64];
+        snprintf(what, sizeof(what), "mul_mat_id %lld experts x %lld tokens", (long long) E, (long long) n);
+        ok &= same(c0, c1, what);
+    }
+
+    {   // How long one expert matrix (2048 x 512) takes to repack, the cost the
+        // cache pays on every admission.
+        const int64_t blocks = K * M / 256;
+        std::vector<uint8_t> dst(blocks * sizeof(block_qt2_r));
+        const int64_t t0 = ggml_time_us();
+        const int reps = 20;
+        for (int r = 0; r < reps; ++r) {
+            ggml_repack_qt_ms32k4_qt2_r((const block_qt_ms32k4 *) a0->data, (block_qt2_r *) dst.data(), blocks);
+        }
+        const double ms = (ggml_time_us() - t0) / 1000.0 / reps;
+        printf("repack %lld blocks (%.1f MB of weights): %.2f ms, %.2f G weights/s\n",
+               (long long) blocks, blocks * 54 / 1e6, ms, blocks * 256 / ms / 1e6);
+    }
+
+    ggml_free(ctx);
+    printf("%s\n", ok ? "PASS" : "FAIL");
+    return ok ? 0 : 1;
+}
