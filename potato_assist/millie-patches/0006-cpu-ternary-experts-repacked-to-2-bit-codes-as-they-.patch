 #define ggml_vec_dot_q4_sym16k_q8_0_generic ggml_vec_dot_q4_sym16k_q8_0
 #define ggml_gemv_q4_sym16_4x4_q8_0_generic ggml_gemv_q4_sym16_4x4_q8_0
 #define ggml_gemm_q4_sym16_4x4_q8_0_generic ggml_gemm_q4_sym16_4x4_q8_0
@@ -195,6 +198,7 @@
 #define ggml_vec_dot_q1_sym32k_q8_0_generic ggml_vec_dot_q1_sym32k_q8_0
 #define ggml_vec_dot_q2_sym32k4_q8_0_generic ggml_vec_dot_q2_sym32k4_q8_0
 #define ggml_vec_dot_qt_ms32k4_q8_0_generic ggml_vec_dot_qt_ms32k4_q8_0
+#define ggml_vec_dot_qt2_r_q8_0_generic ggml_vec_dot_qt2_r_q8_0
 #define ggml_vec_dot_q4_sym16k_q8_0_generic ggml_vec_dot_q4_sym16k_q8_0
 #define ggml_gemv_q4_sym16_4x4_q8_0_generic ggml_gemv_q4_sym16_4x4_q8_0
 #define ggml_gemm_q4_sym16_4x4_q8_0_generic ggml_gemm_q4_sym16_4x4_q8_0
@@ -246,6 +250,7 @@
 #define ggml_vec_dot_q1_sym32k_q8_0_generic ggml_vec_dot_q1_sym32k_q8_0
 #define ggml_vec_dot_q2_sym32k4_q8_0_generic ggml_vec_dot_q2_sym32k4_q8_0
 #define ggml_vec_dot_qt_ms32k4_q8_0_generic ggml_vec_dot_qt_ms32k4_q8_0
+#define ggml_vec_dot_qt2_r_q8_0_generic ggml_vec_dot_qt2_r_q8_0
 #define ggml_vec_dot_q4_sym16k_q8_0_generic ggml_vec_dot_q4_sym16k_q8_0
 #define ggml_gemv_q4_sym16_4x4_q8_0_generic ggml_gemv_q4_sym16_4x4_q8_0
 #define ggml_gemm_q4_sym16_4x4_q8_0_generic ggml_gemm_q4_sym16_4x4_q8_0
@@ -297,6 +302,7 @@
 #define ggml_vec_dot_q1_sym32k_q8_0_generic ggml_vec_dot_q1_sym32k_q8_0
 #define ggml_vec_dot_q2_sym32k4_q8_0_generic ggml_vec_dot_q2_sym32k4_q8_0
 #define ggml_vec_dot_qt_ms32k4_q8_0_generic ggml_vec_dot_qt_ms32k4_q8_0
+#define ggml_vec_dot_qt2_r_q8_0_generic ggml_vec_dot_qt2_r_q8_0
 #define ggml_vec_dot_q4_sym16k_q8_0_generic ggml_vec_dot_q4_sym16k_q8_0
 #define ggml_gemv_q4_sym16_4x4_q8_0_generic ggml_gemv_q4_sym16_4x4_q8_0
 #define ggml_gemm_q4_sym16_4x4_q8_0_generic ggml_gemm_q4_sym16_4x4_q8_0
@@ -371,6 +377,7 @@
 #define ggml_vec_dot_q1_sym32k_q8_0_generic ggml_vec_dot_q1_sym32k_q8_0
 #define ggml_vec_dot_q2_sym32k4_q8_0_generic ggml_vec_dot_q2_sym32k4_q8_0
 #define ggml_vec_dot_qt_ms32k4_q8_0_generic ggml_vec_dot_qt_ms32k4_q8_0
+#define ggml_vec_dot_qt2_r_q8_0_generic ggml_vec_dot_qt2_r_q8_0
 #define ggml_vec_dot_q4_sym16k_q8_0_generic ggml_vec_dot_q4_sym16k_q8_0
 #define ggml_gemv_q4_sym16_4x4_q8_0_generic ggml_gemv_q4_sym16_4x4_q8_0
