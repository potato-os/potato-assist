diff --git a/ggml/src/ggml-cpu/arch/arm/quants.c b/ggml/src/ggml-cpu/arch/arm/quants.c
index 58e597c..800f070 100644
--- a/ggml/src/ggml-cpu/arch/arm/quants.c
+++ b/ggml/src/ggml-cpu/arch/arm/quants.c
@@ -469,6 +469,66 @@ void ggml_vec_dot_qt_ms32k4_q8_0(int n, float * GGML_RESTRICT s, size_t bs, cons
 #endif
 }
 
+#if defined(__ARM_NEON)
+// QT2_R's 2-bit codes to the ternary values of the 8 sub-blocks: byte p of qs
+// holds elements p, p+64, p+128, p+192 at bits 0, 2, 4, 6 (#185).
+static inline __attribute__((always_inline)) void qt2_r_decode(const block_qt2_r * GGML_RESTRICT x, int8x16_t q[QKT_MS32K_SUPER][2]) {
+    const uint8x16_t m3  = vdupq_n_u8(3);
+    const int8x16_t  one = vdupq_n_s8(1);
+    const uint8x16_t Q0 = vld1q_u8(x->qs), Q1 = vld1q_u8(x->qs + 16), Q2 = vld1q_u8(x->qs + 32), Q3 = vld1q_u8(x->qs + 48);
+#define QT2_VAL(v) vsubq_s8(vreinterpretq_s8_u8(v), one)
+    q[0][0] = QT2_VAL(vandq_u8(Q0, m3));                 q[0][1] = QT2_VAL(vandq_u8(Q1, m3));
+    q[1][0] = QT2_VAL(vandq_u8(Q2, m3));                 q[1][1] = QT2_VAL(vandq_u8(Q3, m3));
+    q[2][0] = QT2_VAL(vandq_u8(vshrq_n_u8(Q0, 2), m3));  q[2][1] = QT2_VAL(vandq_u8(vshrq_n_u8(Q1, 2), m3));
+    q[3][0] = QT2_VAL(vandq_u8(vshrq_n_u8(Q2, 2), m3));  q[3][1] = QT2_VAL(vandq_u8(vshrq_n_u8(Q3, 2), m3));
+    q[4][0] = QT2_VAL(vandq_u8(vshrq_n_u8(Q0, 4), m3));  q[4][1] = QT2_VAL(vandq_u8(vshrq_n_u8(Q1, 4), m3));
+    q[5][0] = QT2_VAL(vandq_u8(vshrq_n_u8(Q2, 4), m3));  q[5][1] = QT2_VAL(vandq_u8(vshrq_n_u8(Q3, 4), m3));
+    q[6][0] = QT2_VAL(vshrq_n_u8(Q0, 6));                q[6][1] = QT2_VAL(vshrq_n_u8(Q1, 6));
+    q[7][0] = QT2_VAL(vshrq_n_u8(Q2, 6));                q[7][1] = QT2_VAL(vshrq_n_u8(Q3, 6));
+#undef QT2_VAL
+}
+#endif
+
+// The ternary GEMV on repacked codes: the same integer values and the same
+// float order as ggml_vec_dot_qt_ms32k4_q8_0, so the same result to the bit.
+void ggml_vec_dot_qt2_r_q8_0(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, const void * GGML_RESTRICT vy, size_t by, int nrc) {
+    assert(n % QKT_MS32K == 0);
+    assert(nrc == 1);
+    UNUSED(nrc); UNUSED(bx); UNUSED(by); UNUSED(bs);
+
+#if defined(__ARM_NEON)
+    const int nb = n / QKT_MS32K;
+    const block_qt2_r * GGML_RESTRICT x = vx;
+    const block_q8_0  * GGML_RESTRICT y = vy;
+
+    float sumf = 0.0f;
+    for (int i = 0; i < nb; i++) {
+        const float d = GGML_CPU_FP16_TO_FP32(x[i].d);
+        int8x16_t q[QKT_MS32K_SUPER][2];
+        qt2_r_decode(&x[i], q);
+        float32x4_t accv = vdupq_n_f32(0.0f);
+        for (int g4 = 0; g4 < 2; ++g4) {
+            int32x4_t p[4];
+            float sc4[4], d84[4];
+            for (int t = 0; t < 4; ++t) {
+                const int sb = 4*g4 + t;
+                const block_q8_0 * GGML_RESTRICT yb = &y[i*QKT_MS32K_SUPER + sb];
+                sc4[t] = (float)((sb & 1) ? (x[i].scales[sb >> 1] >> 4) : (x[i].scales[sb >> 1] & 0x0F));
+                d84[t] = GGML_CPU_FP16_TO_FP32(yb->d);
+                const int32x4_t pt = ggml_vdotq_s32(vdupq_n_s32(0), q[sb][0], vld1q_s8(yb->qs));
+                p[t] = ggml_vdotq_s32(pt, q[sb][1], vld1q_s8(yb->qs + 16));
+            }
+            const int32x4_t grp = vpaddq_s32(vpaddq_s32(p[0], p[1]), vpaddq_s32(p[2], p[3]));
+            accv = vfmaq_f32(accv, vcvtq_f32_s32(grp), vmulq_f32(vld1q_f32(sc4), vld1q_f32(d84)));
+        }
+        sumf += d * vaddvq_f32(accv);
+    }
+    *s = sumf;
+#else
+    ggml_vec_dot_qt2_r_q8_0_generic(n, s, bs, vx, bx, vy, by, nrc);
+#endif
+}
+
 void ggml_vec_dot_q4_sym16k_q8_0(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, const void * GGML_RESTRICT vy, size_t by, int nrc) {
     assert(n % QK4_SYM16K == 0);
     assert(nrc == 1);
@@ -673,6 +733,52 @@ static inline __attribute__((always_inline)) void qt_ms32k4_q8_0_tile(
     for (int c = 0; c < NR; ++c) for (int r = 0; r < MR; ++r) dst[c][r0 + r] = sums[r][c];
 }
 
+static inline __attribute__((always_inline)) void qt2_r_q8_0_tile(
+        const int MR, const int NR, const int nb, const uint8_t * GGML_RESTRICT vx, const size_t bx,
+        const block_q8_0 * const * GGML_RESTRICT ys, float * const * GGML_RESTRICT dst, const int r0) {
+    float sums[MILLIE_TILE_MR_MAX][MILLIE_TILE_NR_MAX];
+    for (int r = 0; r < MR; ++r) for (int c = 0; c < NR; ++c) sums[r][c] = 0.0f;
+
+    for (int i = 0; i < nb; ++i) {
+        int8x16_t q[MILLIE_TILE_MR_MAX][QKT_MS32K_SUPER][2];
+        float     sc[MILLIE_TILE_MR_MAX][QKT_MS32K_SUPER];
+        float     d[MILLIE_TILE_MR_MAX];
+        for (int r = 0; r < MR; ++r) {
+            const block_qt2_r * GGML_RESTRICT x = (const block_qt2_r *) (vx + (size_t) (r0 + r) * bx) + i;
+            d[r] = GGML_CPU_FP16_TO_FP32(x->d);
+            qt2_r_decode(x, q[r]);
+            for (int sb = 0; sb < QKT_MS32K_SUPER; ++sb) {
+                sc[r][sb] = (float)((sb & 1) ? (x->scales[sb >> 1] >> 4) : (x->scales[sb >> 1] & 0x0F));
+            }
+        }
+        for (int c = 0; c < NR; ++c) {
+            const block_q8_0 * GGML_RESTRICT y = ys[c] + QKT_MS32K_SUPER*i;
+            int8x16_t yv[QKT_MS32K_SUPER][2];
+            float d8[QKT_MS32K_SUPER];
+            for (int sb = 0; sb < QKT_MS32K_SUPER; ++sb) {
+                yv[sb][0] = vld1q_s8(y[sb].qs);
+                yv[sb][1] = vld1q_s8(y[sb].qs + 16);
+                d8[sb]    = GGML_CPU_FP16_TO_FP32(y[sb].d);
+            }
+            for (int r = 0; r < MR; ++r) {
+                float32x4_t accv = vdupq_n_f32(0.0f);
+                for (int g4 = 0; g4 < 2; ++g4) {
+                    int32x4_t p[4];
+                    for (int t = 0; t < 4; ++t) {
+                        const int sb = 4*g4 + t;
+                        const int32x4_t pt = ggml_vdotq_s32(vdupq_n_s32(0), q[r][sb][0], yv[sb][0]);
+                        p[t] = ggml_vdotq_s32(pt, q[r][sb][1], yv[sb][1]);
+                    }
+                    const int32x4_t grp = vpaddq_s32(vpaddq_s32(p[0], p[1]), vpaddq_s32(p[2], p[3]));
+                    accv = vfmaq_f32(accv, vcvtq_f32_s32(grp), vmulq_f32(vld1q_f32(&sc[r][4*g4]), vld1q_f32(&d8[4*g4])));
+                }
+                sums[r][c] += d[r] * vaddvq_f32(accv);
+            }
+        }
+    }
+    for (int c = 0; c < NR; ++c) for (int r = 0; r < MR; ++r) dst[c][r0 + r] = sums[r][c];
+}
+
 #define MILLIE_TILE_FN(type, MR, NR) \
     static void type##_q8_0_tile_##MR##x##NR(int nb, const uint8_t * vx, size_t bx, \
             const block_q8_0 * const * ys, float * const * dst, int r0) { \
@@ -685,6 +791,7 @@ static inline __attribute__((always_inline)) void qt_ms32k4_q8_0_tile(
     MILLIE_TILE_FN(type, 1, 8) MILLIE_TILE_FN(type, 2, 8) MILLIE_TILE_FN(type, 4, 8) MILLIE_TILE_FN(type, 8, 8)
 MILLIE_TILE_SHAPES(q4_sym16k)
 MILLIE_TILE_SHAPES(qt_ms32k4)
+MILLIE_TILE_SHAPES(qt2_r)
 
 typedef void (*millie_tile_fn)(int, const uint8_t *, size_t, const block_q8_0 * const *, float * const *, int);
 #define MILLIE_TILE_ROW(type, MR) { type##_q8_0_tile_##MR##x1, type##_q8_0_tile_##MR##x2, NULL, type##_q8_0_tile_##MR##x4, NULL, NULL, NULL, type##_q8_0_tile_##MR##x8 }
@@ -696,6 +803,10 @@ static const millie_tile_fn millie_tiles_qt[8][8] = {
     [0] = MILLIE_TILE_ROW(qt_ms32k4, 1), [1] = MILLIE_TILE_ROW(qt_ms32k4, 2),
     [3] = MILLIE_TILE_ROW(qt_ms32k4, 4), [7] = MILLIE_TILE_ROW(qt_ms32k4, 8),
 };
+static const millie_tile_fn millie_tiles_qt2[8][8] = {
+    [0] = MILLIE_TILE_ROW(qt2_r, 1), [1] = MILLIE_TILE_ROW(qt2_r, 2),
+    [3] = MILLIE_TILE_ROW(qt2_r, 4), [7] = MILLIE_TILE_ROW(qt2_r, 8),
+};
 
 // MILLIE_TILE_Q4 / MILLIE_TILE_QT = "<MR>x<NR>" pick a shape per type (MR, NR
 // in 1, 2, 4, 8); "0" turns the type's tiles off. Read once.
@@ -744,8 +855,17 @@ int ggml_gemm_qt_ms32k4_q8_0_enabled(void) {
 }
 
 void ggml_gemm_q4_sym16k_q8_0(int n, int nr, int nc, const void * vx, size_t bx, const void * const * vy, float * const * dst) {
-    static int mr = -1, nrr;
-    if (mr < 0) millie_tile_shape("MILLIE_TILE_Q4", 4, 4, &mr, &nrr);
+    static int mr = -1, nrr, mr1, nr1;
+    if (mr < 0) {
+        millie_tile_shape("MILLIE_TILE_Q4", 4, 4, &mr, &nrr);
+        // One column is a decoded token: the rows still share the activation
+        // block, but a narrower tile keeps more of it in registers.
+        millie_tile_shape("MILLIE_TILE_Q4_N1", 2, 1, &mr1, &nr1);
+    }
+    if (nc == 1 && mr1 > 0) {
+        millie_gemm(millie_tiles_q4, mr1, 1, n / QK4_SYM16K, nr, nc, vx, bx, vy, dst);
+        return;
+    }
     millie_gemm(millie_tiles_q4, mr, nrr, n / QK4_SYM16K, nr, nc, vx, bx, vy, dst);
 }
 
@@ -754,6 +874,12 @@ void ggml_gemm_qt_ms32k4_q8_0(int n, int nr, int nc, const void * vx, size_t bx,
     if (mr < 0) millie_tile_shape("MILLIE_TILE_QT", 4, 4, &mr, &nrr);
     millie_gemm(millie_tiles_qt, mr, nrr, n / QKT_MS32K, nr, nc, vx, bx, vy, dst);
 }
+
+void ggml_gemm_qt2_r_q8_0(int n, int nr, int nc, const void * vx, size_t bx, const void * const * vy, float * const * dst) {
+    static int mr = -1, nrr;
+    if (mr < 0) millie_tile_shape("MILLIE_TILE_QT", 4, 4, &mr, &nrr);
+    millie_gemm(millie_tiles_qt2, mr, nrr, n / QKT_MS32K, nr, nc, vx, bx, vy, dst);
