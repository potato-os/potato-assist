From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: jan <1760229+slomin@users.noreply.github.com>
Date: Tue, 22 Sep 2026 18:53:50 +0100
Subject: [PATCH] cpu: ternary experts repacked to 2-bit codes as they are
 admitted (#185)

QT_MS32K4's sign-rank decode costs the CPU about twice the 4-bit type per
weight at one token. QT2_R holds the same ternary values as 2-bit codes with
the same scales, so the CPU decodes an expert with a load, a shift and an AND
per sixteen weights: 1113 -> 395 us for one layer's experts at one token on
the 12R. The hot cache repacks each expert as it lands in its slot, which
costs 0.25 ms per matrix, and the values, the integer dots and the float order
are the GEMV's, so every result is bit-identical.

The admission reads and repacks now run on the compute threads, which would
otherwise spin at the barrier while the reader pool's threads compete for the
big cores. LLAMA_HOT_REPACK=0 and LLAMA_HOT_COOP=0 keep the old paths.

diff --git a/ggml/include/ggml.h b/ggml/include/ggml.h
index 1863a73..3bf1314 100644
--- a/ggml/include/ggml.h
+++ b/ggml/include/ggml.h
@@ -443,7 +443,8 @@ extern "C" {
         GGML_TYPE_Q2_SYM32K4 = 56, // 2.1875 bpw: 2-bit symmetric, sub-block=32, 4-bit UNSIGNED sub-scales + fp16 super-scale per 8 subs
         GGML_TYPE_QT_MS32K4 = 57, // 1.6875 bpw: TERNARY (-1/0/+1), mask+sign coding, sub-block=32, 128 non-zeros per 256-weight block, 4-bit UNSIGNED sub-scales + fp16 super-scale per 8 subs
         GGML_TYPE_Q4_SYM16F = 58, // 4-bit symmetric, group=16, fp16 scale
-        GGML_TYPE_COUNT   = 59,
+        GGML_TYPE_QT2_R     = 59, // 2.1875 bpw: QT_MS32K4 repacked as 2-bit codes for the CPU; never in a file (#185)
+        GGML_TYPE_COUNT   = 60,
     };
 
     // precision
diff --git a/ggml/src/ggml-common.h b/ggml/src/ggml-common.h
index e1168ec..0b0e293 100644
--- a/ggml/src/ggml-common.h
+++ b/ggml/src/ggml-common.h
@@ -274,6 +274,18 @@ typedef struct {
 } block_qt_ms32k4;
 static_assert(sizeof(block_qt_ms32k4) == sizeof(ggml_half) + QKT_MS32K_SUPER/2 + QKT_MS32K/8 + QKT_MS32K_NZTOT/8, "wrong qt_ms32k4 block size/padding");
 
+// QT2_R (#185): QT_MS32K4's ternary values repacked for the CPU as 2-bit codes
+// (value + 1), with the same 4-bit sub-scales and fp16 super-scale. Byte p of
+// qs holds elements p, p+64, p+128 and p+192 at bits 0, 2, 4 and 6, so a
+// 16-byte load and one shift give 16 consecutive weights. Never in a file: the
+// hot-expert cache repacks experts into it as it admits them.
+typedef struct {
+    ggml_half d;                           // fp16 super-scale
+    uint8_t   scales[QKT_MS32K_SUPER / 2]; // 8 x 4-bit unsigned sub-scales
+    uint8_t   qs[QKT_MS32K / 4];           // 2-bit codes
+} block_qt2_r;
+static_assert(sizeof(block_qt2_r) == sizeof(ggml_half) + QKT_MS32K_SUPER/2 + QKT_MS32K/4, "wrong qt2_r block size/padding");
+
 // Q4_SYM16K: 4-bit symmetric K-scale type. 8 sub-blocks of 16 (NOT 32);
 // nibble order is PAIRWISE: byte j of a sub-block holds elements 2j (low
 // nibble) and 2j+1 (high). value = (code - 7.5) * d * scales[s] (int8 sub-scales).
