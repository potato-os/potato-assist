diff --git a/ggml/src/ggml-cpu/repack.cpp b/ggml/src/ggml-cpu/repack.cpp
index 121f384..b1c0b33 100644
--- a/ggml/src/ggml-cpu/repack.cpp
+++ b/ggml/src/ggml-cpu/repack.cpp
@@ -4851,6 +4851,88 @@ class q4_sym16k_x4_traits : public tensor_traits_base {
         return 0;
     }
 };
+
+// #198: the vision encoder's Q4_SYM16F weights, rows interleaved by four. Its
+// matmuls are batched (the encoder runs every patch at once): each column is
+// quantized once, then tiles of four rows by up to eight columns. Bit-identical
+// to ggml_vec_dot_q4_sym16f_f32, so moving a weight here changes no output.
+class q4_sym16f_x4_traits : public tensor_traits_base {
+    static constexpr int64_t CHUNK_COLS = 64;
+
+    bool work_size(int /* n_threads */, const struct ggml_tensor * op, size_t & size) override {
+        if (op->op != GGML_OP_MUL_MAT) {
+            return false;
+        }
+        size = ggml_q4_sym16f_x4_col_size(op->src[1]->ne[0]) * ggml_nrows(op->src[1]);
+        return true;
+    }
+
+    bool compute_forward(struct ggml_compute_params * params, struct ggml_tensor * op) override {
+        if (op->op != GGML_OP_MUL_MAT) {
+            return false;
+        }
+        const ggml_tensor * src0 = op->src[0];
+        const ggml_tensor * src1 = op->src[1];
+        ggml_tensor *       dst  = op;
+
+        GGML_TENSOR_BINARY_OP_LOCALS
+
