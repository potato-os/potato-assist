 #    include <chrono>
 static uint64_t hot_now_ns() {
     return std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
 }
 
+// A short pause, not a yield: the scheduler takes milliseconds to hand a
+// yielded thread its core back, and these waits are tens of microseconds.
+static inline void hot_cpu_relax() {
+#    if defined(__aarch64__) || defined(__arm__)
+    __asm__ __volatile__("yield" ::: "memory");
+#    elif defined(__x86_64__) || defined(__i386__)
+    __asm__ __volatile__("pause" ::: "memory");
+#    else
+    std::atomic_thread_fence(std::memory_order_seq_cst);
+#    endif
+}
+
+// #185: reads [offset, offset + bytes) into `buf` (4 KiB aligned, at least
+// bytes + 8 KiB) and returns where the range starts in it.
+static const unsigned char * hot_pread_into(int fd, size_t offset, size_t bytes, unsigned char * buf) {
+#    if defined(__APPLE__)
+    const size_t lo = offset, hi = offset + bytes;
+#    else
+    const bool   direct = hot_direct_reads();
+    const size_t lo     = direct ? offset & ~size_t(4095) : offset;
+    const size_t hi     = direct ? (offset + bytes + 4095) & ~size_t(4095) : offset + bytes;
+#    endif
+    size_t done = 0;
+    while (done < hi - lo) {
+        ssize_t n = pread(fd, buf + done, hi - lo - done, lo + done);
+        if (n < 0 && errno == EINTR) {
+            continue;
+        }
+        if (n == 0 && done >= (offset - lo) + bytes) {
+            break; // the aligned span ran past the end of the file
+        }
+        if (n <= 0) {
+            GGML_ABORT("hot-cache expert read failed: %s", strerror(errno));
+        }
+        done += n;
+    }
+#    if !defined(__APPLE__)
+    if (!direct) {
+        posix_fadvise(fd, offset, bytes, POSIX_FADV_DONTNEED);
+    }
+#    endif
+    return buf + (offset - lo);
+}
+
+struct hot_range {
+    int    fd;
+    size_t offset, bytes;
+};
+
+// #185: the reader threads of LLAMA_HOT_COOP=2. One batch at a time: range i
+// lands in bufs[i] and ready[i] then points at it.
+struct hot_split_readers {
+    static constexpr size_t MAX = 32;
+
+    std::vector<std::thread>                         threads;
+    std::mutex                                       m;
+    std::condition_variable                          cv;
+    uint64_t                                         generation = 0;
+    bool                                             stop       = false;
+    std::vector<hot_range>                           ranges;
+    std::atomic<size_t>                              next{ 0 };
+    std::atomic<int>                                 busy{ 0 };
+    std::array<std::atomic<const unsigned char *>, MAX> ready{};
+    std::array<unsigned char *, MAX>                 bufs{};
+    size_t                                           cap = 0;
+
+    explicit hot_split_readers(int n) {
+        for (int i = 0; i < n; i++) {
+            threads.emplace_back([this] { loop(); });
+        }
+    }
+
+    ~hot_split_readers() {
+        {
+            std::lock_guard<std::mutex> lk(m);
+            stop = true;
+        }
+        cv.notify_all();
+        for (auto & t : threads) {
+            t.join();
+        }
+        for (auto * b : bufs) {
+            free(b);
+        }
+    }
+
+    // One publisher at a time, after the previous batch has been consumed.
+    // Readers join a batch only under the lock, so none is mid-batch here.
+    void publish(const std::vector<hot_range> & rs) {
+        GGML_ASSERT(rs.size() <= MAX);
+        std::unique_lock<std::mutex> lk(m);
+        while (busy.load(std::memory_order_acquire)) {
+            hot_cpu_relax();
+        }
+        size_t need = 0;
+        for (const auto & r : rs) {
+            need = std::max(need, r.bytes + 8192);
+        }
+        if (need > cap) {
+            for (auto *& b : bufs) {
+                free(b);
+                if (posix_memalign(reinterpret_cast<void **>(&b), 4096, need) != 0) {
+                    GGML_ABORT("hot-cache staging allocation failed");
+                }
+            }
+            cap = need;
+        }
+        for (size_t i = 0; i < rs.size(); i++) {
+            ready[i].store(nullptr, std::memory_order_relaxed);
+        }
+        ranges = rs;
+        next.store(0, std::memory_order_relaxed);
+        ++generation;
+        lk.unlock();
+        cv.notify_all();
+    }
+
+    const unsigned char * wait(size_t i) {
+        const unsigned char * p;
+        while (!(p = ready[i].load(std::memory_order_acquire))) {
+            hot_cpu_relax();
+        }
+        return p;
+    }
+
+    void loop() {
+        uint64_t seen = 0;
+        for (;;) {
+            size_t n;
+            {
+                std::unique_lock<std::mutex> lk(m);
+                cv.wait(lk, [&] { return stop || generation != seen; });
+                if (stop) {
+                    return;
+                }
+                seen = generation;
+                n    = ranges.size();
+                busy.fetch_add(1, std::memory_order_acq_rel);
+            }
+            for (size_t i; (i = next.fetch_add(1, std::memory_order_relaxed)) < n;) {
+                ready[i].store(hot_pread_into(ranges[i].fd, ranges[i].offset, ranges[i].bytes, bufs[i]),
+                               std::memory_order_release);
+            }
+            busy.fetch_sub(1, std::memory_order_release);
+        }
+    }
+};
+
+static int hot_split_reader_count() {
+    const char * e = getenv("LLAMA_HOT_READERS");
+    return e ? std::max(0, atoi(e)) : 3;
+}
+
+static hot_split_readers & hot_split() {
+    static hot_split_readers readers(hot_split_reader_count());
+    return readers;
+}
