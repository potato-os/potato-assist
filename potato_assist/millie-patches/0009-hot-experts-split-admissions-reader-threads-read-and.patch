     return false;
@@ -229,11 +242,175 @@ static bool metal_buffer_is_shared(ggml_backend_buffer_t buffer) {
 
 static std::atomic<uint64_t> g_hot_admissions{ 0 }, g_hot_union_cold{ 0 }; // #183 gate counters
 static std::atomic<uint64_t> g_hot_route_ns{ 0 }, g_hot_read_ns{ 0 }, g_hot_route_calls{ 0 };
+// LAB: cooperative-admission waits (thread 0's arrival wait, helpers' time in the op, slowest job)
+static std::atomic<uint64_t> g_hot_arrive_ns{ 0 }, g_hot_arrive_max_ns{ 0 }, g_hot_helper_ns{ 0 }, g_hot_helper_max_ns{ 0 }, g_hot_job_max_ns{ 0 };
+static void hot_atomic_max(std::atomic<uint64_t> & a, uint64_t v) {
+    uint64_t cur = a.load(std::memory_order_relaxed);
+    while (v > cur && !a.compare_exchange_weak(cur, v, std::memory_order_relaxed)) {}
