From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: jan <1760229+slomin@users.noreply.github.com>
Date: Wed, 23 Sep 2026 20:32:11 +0100
Subject: [PATCH] hot experts: the non-expert weights mapped read-only on the
 CPU (#204)

With --hot-map-dense (llama_model_params.hot_map_dense), a CPU hot-expert
load maps each run of neighbouring non-expert tensors from the file,
read-only, instead of reading them into owned memory. Pressure then drops
those clean pages rather than swapping them. No expert tensor is mapped
(a run's page-aligned ends take in at most a page of a neighbour), and the
expert slots stay owned. Mapped tensors keep the file's layout, so the CPU
repack buffers are off in this mode.

Millie maps 1,435 MiB in one run. Mac CPU, hot 64: peak footprint
4.56 -> 2.85 GB, greedy output byte-identical to the #183 reference.
---
 common/arg.cpp      |   7 +++
 common/common.cpp   |   1 +
 common/common.h     |   1 +
 include/llama.h     |   1 +
 src/llama-model.cpp | 102 +++++++++++++++++++++++++++++++++++++++++++-
 5 files changed, 110 insertions(+), 2 deletions(-)

diff --git a/common/arg.cpp b/common/arg.cpp
index e097367..645d548 100644
--- a/common/arg.cpp
+++ b/common/arg.cpp
@@ -2244,6 +2244,13 @@ common_params_context common_params_parser_init(common_params & params, llama_ex
             params.hot_expert_bias = bias;
         }
     ));
+    add_opt(common_arg(
+        {"--hot-map-dense"},
+        "with --hot-experts on the CPU, map the non-expert weights read-only instead of copying them",
+        [](common_params & params) {
+            params.hot_map_dense = true;
+        }
+    ));
     add_opt(common_arg(
         {"--mlock"},
         "force system to keep model in RAM rather than swapping or compressing",
diff --git a/common/common.cpp b/common/common.cpp
index 977f477..a7ef058 100644
--- a/common/common.cpp
+++ b/common/common.cpp
@@ -1459,6 +1459,7 @@ struct llama_model_params common_model_params_to_llama(common_params & params) {
     mparams.tensor_split    = params.tensor_split;
     mparams.hot_experts = params.hot_experts;
     mparams.hot_expert_bias = params.hot_expert_bias;
+    mparams.hot_map_dense = params.hot_map_dense;
     mparams.use_mmap        = params.use_mmap;
     mparams.use_direct_io   = params.use_direct_io;
     mparams.use_mlock       = params.use_mlock;
diff --git a/common/common.h b/common/common.h
index a1fb00d..4648c0b 100644
--- a/common/common.h
+++ b/common/common.h
@@ -549,6 +549,7 @@ struct common_params {
     bool input_prefix_bos  = false; // prefix BOS to user inputs, preceding input_prefix
     int32_t hot_experts = 0;
     float hot_expert_bias = 1.0f;
+    bool hot_map_dense = false;
     bool use_mmap          = true;  // enable mmap to use filesystem cache
     bool use_direct_io     = false; // read from disk without buffering
     bool use_mlock         = false; // use mlock to keep model in memory
diff --git a/include/llama.h b/include/llama.h
index 767f7ff..04c1fb0 100644
--- a/include/llama.h
+++ b/include/llama.h
@@ -326,6 +326,7 @@ extern "C" {
         bool use_extra_bufts; // use extra buffer types (used for weight repacking)
         bool no_host;         // bypass host buffer allowing extra buffers to be used
         bool no_alloc;        // only load metadata and simulate memory allocations
+        bool hot_map_dense;   // hot experts on the CPU: map the non-expert weights read-only instead of copying them
     };
 
     struct llama_sampler_seq_config {
diff --git a/src/llama-model.cpp b/src/llama-model.cpp
index b8d8c09..3e01d20 100644
--- a/src/llama-model.cpp
+++ b/src/llama-model.cpp
@@ -18,9 +18,16 @@
 #include "models/models.h"
 
 #include "ggml.h"
+#include "ggml-alloc.h"
 #include "ggml-cpp.h"
 
 #include <algorithm>
+#ifndef _WIN32
+#include <unistd.h>
+#if defined(_POSIX_MAPPED_FILES)
+#include <sys/mman.h>
+#endif
+#endif
 #include <cassert>
 #include <cfloat>
 #include <cstdint>
@@ -646,7 +653,16 @@ static buft_list_t make_gpu_buft_list(ggml_backend_dev_t dev, llama_split_mode s
 
 struct llama_model::impl {
     impl() = default;
-    ~impl() = default;
+    ~impl() {
+#if defined(_POSIX_MAPPED_FILES)
+        for (const auto & [addr, len] : dense_maps) {
+            munmap(addr, len);
+        }
+#endif
+    }
+
+    // #204: read-only mappings of the non-expert weights (hot_map_dense)
+    std::vector<std::pair<void *, size_t>> dense_maps;
 
     uint64_t n_elements = 0;
 
@@ -3017,7 +3033,9 @@ bool llama_model::load_tensors(llama_model_loader & ml) {
         __func__, ml.use_mmap ? "true" : "false", ml.use_direct_io ? "true" : "false");
 
     // build a list of buffer types for the CPU and GPU devices
-    pimpl->cpu_buft_list = make_cpu_buft_list(devices, params.use_extra_bufts, params.no_host);
+    // #204: mapped weights stay in the file's layout, so the repack buffers are off.
+    const bool map_dense = hot_cache && params.hot_map_dense && devices.empty();
+    pimpl->cpu_buft_list = make_cpu_buft_list(devices, params.use_extra_bufts && !map_dense, params.no_host);
     for (const auto & dev : devices) {
         buft_list_t buft_list = make_gpu_buft_list(dev.dev, split_mode, tensor_split);
         // add CPU buffer types as a fallback
@@ -8004,6 +8022,85 @@ bool llama_model::load_tensors(llama_model_loader & ml) {
             buf_map.emplace(weight->idx, buf);
             pimpl->mappings.emplace_back(std::move(mapping));
             LLAMA_LOG_INFO("%s: mapped input embeddings (%zu bytes)\n", __func__, bytes);
+#if defined(_POSIX_MAPPED_FILES)
+        } else if (map_dense && !ml.no_alloc && !use_mlock && buffer_from_host_ptr_supported && is_default_buft &&
+                ggml_backend_dev_type(dev) == GGML_BACKEND_DEVICE_TYPE_CPU) {
+            // #204: each run of neighbouring non-expert tensors gets its own read-only mapping, so memory
+            // pressure drops clean pages instead of swapping them. No expert tensor is mapped: a run's
+            // page-aligned ends take in at most a page of a neighbour (mapping the whole file rebooted
+            // the 12R). The expert slots, and anything not in the file, are owned.
+            struct dense_tensor { ggml_tensor * t; const llama_model_loader::llama_tensor_weight * w; };
+            std::vector<dense_tensor> dense;
+            std::vector<ggml_tensor *> owned;
+            for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != nullptr; t = ggml_get_next_tensor(ctx, t)) {
+                const auto * w = ml.get_weight(ggml_get_name(t));
+                if (w && !strstr(ggml_get_name(t), "_exps.weight")) {
+                    dense.push_back({t, w});
+                } else {
+                    owned.push_back(t);
+                }
+            }
+            std::sort(dense.begin(), dense.end(), [](const dense_tensor & a, const dense_tensor & b) {
+                return a.w->idx != b.w->idx ? a.w->idx < b.w->idx : a.w->offs < b.w->offs;
+            });
+            const size_t page = (size_t) sysconf(_SC_PAGESIZE);
+            const size_t max_size = ggml_get_max_tensor_size(ctx);
+            size_t mapped = 0;
+            size_t runs = 0;
+            for (size_t i = 0; i < dense.size();) {
+                const uint16_t idx = dense[i].w->idx;
+                size_t end = dense[i].w->offs + ggml_nbytes(dense[i].t);
+                size_t j = i + 1;
+                // a gap of at most a page is alignment padding: every expert tensor is megabytes
+                while (j < dense.size() && dense[j].w->idx == idx && dense[j].w->offs <= end + page) {
+                    end = std::max(end, dense[j].w->offs + ggml_nbytes(dense[j].t));
+                    j++;
+                }
+                const size_t base = dense[i].w->offs & ~(page - 1);
+                const size_t len = end - base;
+                void * addr = mmap(nullptr, len, PROT_READ, MAP_SHARED, ml.files.at(idx)->file_id(), (off_t) base);
+                if (addr == MAP_FAILED) {
+                    throw std::runtime_error(format("mapping %zu weight bytes failed: %s", len, strerror(errno)));
+                }
+                pimpl->dense_maps.emplace_back(addr, len);
+                posix_madvise(addr, len, POSIX_MADV_WILLNEED);
+                ggml_backend_buffer_t buf = ggml_backend_dev_buffer_from_host_ptr(dev, addr, len, max_size);
+                if (buf == nullptr) {
+                    throw std::runtime_error("CPU weight mapping buffer allocation failed");
+                }
+                bufs.emplace_back(buf);
+                for (size_t k = i; k < j; k++) {
+                    ggml_backend_tensor_alloc(buf, dense[k].t, (char *) addr + (dense[k].w->offs - base));
+                    ml.externally_mapped_tensors.insert(dense[k].t);
+                    mapped += ggml_nbytes(dense[k].t);
+                }
+                if (!buf_map.count(idx)) {
+                    buf_map.emplace(idx, buf);
+                }
+                runs++;
+                i = j;
+            }
+            if (!owned.empty()) {
+                const size_t align = ggml_backend_buft_get_alignment(buft);
+                size_t size = 0;
+                for (ggml_tensor * t : owned) {
+                    size += GGML_PAD(ggml_backend_buft_get_alloc_size(buft, t), align);
+                }
+                ggml_backend_buffer_t buf = ggml_backend_buft_alloc_buffer(buft, size);
+                if (buf == nullptr) {
+                    throw std::runtime_error(format("unable to allocate %s buffer", ggml_backend_buft_name(buft)));
+                }
+                ggml_tallocr talloc = ggml_tallocr_new(buf);
+                for (ggml_tensor * t : owned) {
+                    ggml_tallocr_alloc(&talloc, t);
+                }
+                bufs.emplace_back(buf);
+                for (uint32_t idx = 0; idx < ml.files.size(); idx++) {
+                    buf_map[idx] = buf;
+                }
+            }
+            LLAMA_LOG_INFO("%s: mapped %zu non-expert weight bytes in %zu runs\n", __func__, mapped, runs);
+#endif
         } else if (ml.use_mmap && use_mmap_buffer && buffer_from_host_ptr_supported && is_default_buft) {
             GGML_ASSERT(!ml.no_alloc);
             for (uint32_t idx = 0; idx < ml.files.size(); idx++) {
@@ -9169,6 +9266,7 @@ llama_model_params llama_model_default_params() {
         /*.use_extra_bufts             =*/ true,
         /*.no_host                     =*/ false,
         /*.no_alloc                    =*/ false,
+        /*.hot_map_dense               =*/ false,
     };
 
     return result;
