+// #190: expert prefetch. At layer L the next layer's router, applied to layer
+// L's routing input, predicts which experts L+1 will select; its cold ones are
+// read ahead into side buffers while L and L+1's attention compute. When L+1
+// admits an expert that was predicted, its repack takes the bytes from there
+// instead of waiting on flash. The policy and the bytes are unchanged, so the
+// outputs are too: only where the admission's bytes come from differs.
+// On a Mac trace of 128 greedy tokens the next router (float) finds half of
+// the next layer's misses at about one read per miss (top 8); on the 12R the
+// int8 copy here serves 64% of admissions. LLAMA_HOT_PREFETCH=0 turns it off,
+// LLAMA_HOT_PREFETCH_N sets the rank cut.
+
 static bool hot_fast_topk() {
     static const bool on = !getenv("LLAMA_HOT_FAST_TOPK") || atoi(getenv("LLAMA_HOT_FAST_TOPK")) != 0;
     return on;
 }
 
+static bool hot_prefetch_on() {
+    static const bool on = !getenv("LLAMA_HOT_PREFETCH") || atoi(getenv("LLAMA_HOT_PREFETCH")) != 0;
+    return on;
+}
+
+static int hot_prefetch_rank() {
+    static const int n = getenv("LLAMA_HOT_PREFETCH_N") ? std::max(1, std::min(32, atoi(getenv("LLAMA_HOT_PREFETCH_N")))) : 8;
+    return n;
+}
+
+struct hot_prefetch_entry {
+    enum { FREE = 0, CLAIMING = 1, READING = 2, READY = 3 };
+    std::atomic<int>          state{ FREE };
+    std::atomic<bool>         released{ false };
+    std::atomic<int>          left{ 0 };
+    int                       layer  = -1, expert = -1;
+    uint64_t                  token  = 0;
+    std::array<unsigned char *, 3>                    buf{};
+    std::array<std::atomic<const unsigned char *>, 3> data{};
+    size_t                    cap = 0;
+
+    void try_free() {
+        int r = READY;
+        state.compare_exchange_strong(r, FREE, std::memory_order_acq_rel);
+    }
+
+    const unsigned char * wait(int k) const {
+        const unsigned char * p;
+        while (!(p = data[k].load(std::memory_order_acquire))) {
+            hot_cpu_relax();
+        }
+        return p;
+    }
+};
+
+struct hot_prefetcher {
+    static constexpr int ENTRIES = 24;
+
+    struct range_job {
+        hot_prefetch_entry * e;
+        int                  k;
+        hot_range            r;
+    };
+
+    std::array<hot_prefetch_entry, ENTRIES> entries;
+    std::mutex                              m;
+    std::condition_variable                 cv;
+    std::vector<range_job>                  reads;
+    bool                                    stop = false;
+    std::vector<std::thread>                threads;
+    std::atomic<uint64_t> issued{ 0 }, used{ 0 }, ready_at_use{ 0 }, wait_ns{ 0 }, dropped{ 0 };
+
+    hot_prefetcher() {
+        for (int i = 0; i < 3; i++) {
+            threads.emplace_back([this] { read_loop(); });
+        }
+    }
+
+    ~hot_prefetcher() {
+        {
+            std::lock_guard<std::mutex> lk(m);
+            stop = true;
+        }
+        cv.notify_all();
+        for (auto & t : threads) {
+            t.join();
+        }
+        for (auto & e : entries) {
+            for (auto * b : e.buf) {
+                free(b);
+            }
+        }
+    }
+
+    // Thread 0, at the target layer's admission, before any job runs.
+    hot_prefetch_entry * find(int layer, int expert, uint64_t token) {
+        for (auto & e : entries) {
+            const int st = e.state.load(std::memory_order_acquire);
+            if ((st == hot_prefetch_entry::READING || st == hot_prefetch_entry::READY) && e.layer == layer &&
+                e.expert == expert && e.token == token && !e.released.load(std::memory_order_relaxed)) {
+                used++;
+                ready_at_use += st == hot_prefetch_entry::READY;
+                return &e;
+            }
+        }
+        return nullptr;
+    }
+
+    // Thread 0, once the layer's admissions for `token` are done: every entry
+    // of this layer up to this token is spent, used or not.
+    void release(int layer, uint64_t token) {
+        for (auto & e : entries) {
+            const int st = e.state.load(std::memory_order_acquire);
+            if ((st == hot_prefetch_entry::READING || st == hot_prefetch_entry::READY) && e.layer == layer && e.token <= token) {
+                e.released.store(true, std::memory_order_seq_cst);
+                if (e.state.load(std::memory_order_seq_cst) == hot_prefetch_entry::READY) {
+                    e.try_free();
+                }
+            }
+        }
+    }
+
+    // Thread 0: read `expert` of `target` ahead for `token`. base: each expert
+    // tensor's fd, its offset in the file and the per-expert stride.
+    bool issue(int target, uint64_t token, int expert, const std::array<hot_range, 3> & base) {
+        hot_prefetch_entry * slot = nullptr;
+        for (auto & e : entries) {
+            int f = hot_prefetch_entry::FREE;
+            if (e.state.compare_exchange_strong(f, hot_prefetch_entry::CLAIMING, std::memory_order_acq_rel)) {
+                slot = &e;
+                break;
+            }
+        }
+        if (!slot) {
+            dropped++;
+            return false;
+        }
+        size_t need = 0;
+        for (int k = 0; k < 3; ++k) need = std::max(need, base[k].bytes + 8192);
+        if (need > slot->cap) {
+            for (auto *& b : slot->buf) {
+                free(b);
+                if (posix_memalign(reinterpret_cast<void **>(&b), 4096, need) != 0) {
+                    GGML_ABORT("hot-cache prefetch allocation failed");
+                }
+            }
+            slot->cap = need;
+        }
+        slot->layer  = target;
+        slot->expert = expert;
+        slot->token  = token;
+        slot->released.store(false, std::memory_order_relaxed);
+        slot->left.store(3, std::memory_order_relaxed);
+        for (auto & d : slot->data) d.store(nullptr, std::memory_order_relaxed);
+        slot->state.store(hot_prefetch_entry::READING, std::memory_order_release);
+        issued++;
+        std::lock_guard<std::mutex> lk(m);
+        for (int k = 0; k < 3; ++k) {
+            reads.push_back({ slot, k, { base[k].fd, base[k].offset + expert * base[k].bytes, base[k].bytes } });
+        }
+        return true;
+    }
+
+    void kick() { cv.notify_all(); }
+
+    void read_loop() {
+        for (;;) {
+            range_job j;
+            {
+                std::unique_lock<std::mutex> lk(m);
+                cv.wait(lk, [&] { return stop || !reads.empty(); });
+                if (stop) {
+                    return;
+                }
+                j = reads.front();
+                reads.erase(reads.begin());
+            }
+            j.e->data[j.k].store(hot_pread_into(j.r.fd, j.r.offset, j.r.bytes, j.e->buf[j.k]), std::memory_order_release);
+            if (j.e->left.fetch_sub(1, std::memory_order_acq_rel) == 1) {
+                j.e->state.store(hot_prefetch_entry::READY, std::memory_order_seq_cst);
+                if (j.e->released.load(std::memory_order_seq_cst)) {
+                    j.e->try_free();
+                }
+            }
+        }
+    }
+};
+
+static hot_prefetcher & hot_prefetch() {
+    static hot_prefetcher p;
+    return p;
+}
