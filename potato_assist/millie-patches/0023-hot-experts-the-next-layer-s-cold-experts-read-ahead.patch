     std::map<int, std::unique_ptr<layer_state>> layers;
 
+    // #190: every layer's router as int8 rows, for predicting its experts from
+    // the previous layer's routing input.
+    struct q8_router {
+        int64_t             n = 0;
+        std::vector<int8_t> w;
+        std::array<float, 256> scale{};
+    };
+    std::map<int, q8_router> q8_routers;
+
+    void build_q8_router(int il, const float * data, int64_t n, int64_t rows) {
+        if (rows != 256 || n % 16 != 0) {
+            return;
+        }
+        auto & q = q8_routers[il];
+        q.n = n;
+        q.w.resize(256 * q.n);
+        for (int e = 0; e < 256; ++e) {
+            const float * row = data + e * n;
+            float amax = 0;
+            for (int64_t k = 0; k < q.n; ++k) amax = std::max(amax, std::fabs(row[k]));
+            const float id = amax > 0 ? 127.0f / amax : 0.0f;
+            for (int64_t k = 0; k < q.n; ++k) q.w[e * q.n + k] = (int8_t) std::lrint(row[k] * id);
+            q.scale[e] = amax / 127.0f;
+        }
+    }
+
+    // The rows [r0, r1) of layer t's predicted router scores from x.
+    static void predict_rows(const q8_router & q, const float * x, int r0, int r1, float * out) {
+        thread_local std::vector<int8_t> xq;
+        xq.resize(q.n);
+        float amax = 0;
+        for (int64_t k = 0; k < q.n; ++k) amax = std::max(amax, std::fabs(x[k]));
+        const float id = amax > 0 ? 127.0f / amax : 0.0f;
+        for (int64_t k = 0; k < q.n; ++k) xq[k] = (int8_t) std::lrint(x[k] * id);
+        const float xs = amax / 127.0f;
+        for (int e = r0; e < r1; ++e) {
+            const int8_t * row = q.w.data() + e * q.n;
+            int32_t acc = 0;
+#    if defined(__ARM_NEON)
+            int32x4_t a = vdupq_n_s32(0);
+            for (int64_t k = 0; k < q.n; k += 16) {
+                const int8x16_t wv = vld1q_s8(row + k), xv = vld1q_s8(xq.data() + k);
+                a = vpadalq_s16(a, vmull_s8(vget_low_s8(wv), vget_low_s8(xv)));
+                a = vpadalq_s16(a, vmull_high_s8(wv, xv));
+            }
+            acc = vaddvq_s32(a);
+#    else
+            for (int64_t k = 0; k < q.n; ++k) acc += row[k] * xq[k];
+#    endif
+            out[e] = acc * q.scale[e] * xs;
+        }
+    }
+
+    // Whether this route step predicts the next layer (every thread decides alike).
+    const q8_router * prefetch_target(const layer_state & s, const ggml_tensor * dst) const {
+        if (gpu_routing || !hot_prefetch_on() || !hot_cooperative_reads() || hot_coop_mode() != 2 || !dst->src[1] ||
+            dst->src[0]->ne[1] != 1) {
+            return nullptr;
+        }
+        auto q  = q8_routers.find(s.layer_index + 1);
+        auto lt = layers.find(s.layer_index + 1);
+        if (q == q8_routers.end() || lt == layers.end() || lt->second->weights.size() != 3 ||
+            dst->src[1]->ne[0] != q->second.n) {
+            return nullptr;
+        }
+        return &q->second;
+    }
+
+    // Thread 0: the next layer's cold experts among its predicted top-n, read ahead.
+    void prefetch_issue(const layer_state & s, const float * score) {
+        auto & ts  = *layers.at(s.layer_index + 1);
+        const int top = hot_prefetch_rank();
+        std::array<float, 256> biased;
+        std::array<int, 256>   idx;
+        for (int e = 0; e < 256; ++e) {
+            biased[e] = score[e] + (ts.policy.slots[e] >= 0 ? bias : 0.0f);
+            idx[e]    = e;
+        }
+        std::partial_sort(idx.begin(), idx.begin() + top, idx.end(), [&](int a, int b) { return biased[a] > biased[b]; });
+        std::array<hot_range, 3> base;
+        for (int k = 0; k < 3; ++k) base[k] = { ts.weights[k]->fd, ts.weights[k]->offset, ts.weights[k]->stride };
+        bool any = false;
+        for (int i = 0; i < top; ++i) {
+            if (ts.policy.slots[idx[i]] < 0) {
+                any |= hot_prefetch().issue(ts.layer_index, ts.tokens, idx[i], base);
+            }
+        }
+        if (any) {
+            hot_prefetch().kick();
+        }
+    }
+
