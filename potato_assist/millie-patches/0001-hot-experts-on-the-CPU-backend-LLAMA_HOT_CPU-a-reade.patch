+// #183 CPU port. GCD is Apple-only; elsewhere a small persistent pool fans the
+// expert reads out. The caller participates, so a pool of N gives N + 1 readers.
+#    if defined(__APPLE__)
+static void hot_parallel_for(size_t count, void * ctx, void (*fn)(void *, size_t)) {
+    dispatch_apply_f(count, dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ctx, fn);
+}
+#    else
+struct hot_pool {
+    std::vector<std::thread>  workers;
+    std::mutex                m;
+    std::condition_variable   cv, done_cv;
+    void (*fn)(void *, size_t) = nullptr;
+    void *                    ctx        = nullptr;
+    size_t                    n          = 0;
+    std::atomic<size_t>       next{ 0 }, finished{ 0 };
+    uint64_t                  generation = 0;
+    bool                      stop       = false;
+
+    explicit hot_pool(int threads) {
+        for (int i = 0; i < threads; i++) {
+            workers.emplace_back([this] { loop(); });
+        }
+    }
+
+    ~hot_pool() {
+        {
+            std::lock_guard<std::mutex> lk(m);
+            stop = true;
+        }
+        cv.notify_all();
+        for (auto & t : workers) {
+            t.join();
+        }
+    }
+
+    void work(void (*f)(void *, size_t), void * c, size_t count) {
+        for (size_t i; (i = next.fetch_add(1)) < count;) {
+            f(c, i);
+        }
+        if (finished.fetch_add(1) + 1 == workers.size() + 1) {
+            std::lock_guard<std::mutex> lk(m);
+            done_cv.notify_all();
+        }
+    }
+
+    void loop() {
+        uint64_t seen = 0;
+        for (;;) {
+            void (*f)(void *, size_t);
+            void * c;
+            size_t count;
+            {
+                std::unique_lock<std::mutex> lk(m);
+                cv.wait(lk, [&] { return stop || generation != seen; });
+                if (stop) {
+                    return;
+                }
+                seen  = generation;
+                f     = fn;
+                c     = ctx;
+                count = n;
+            }
+            work(f, c, count);
+        }
+    }
+
+    void run(size_t count, void * c, void (*f)(void *, size_t)) {
+        {
+            std::lock_guard<std::mutex> lk(m);
+            fn       = f;
+            ctx      = c;
+            n        = count;
+            next     = 0;
+            finished = 0;
+            ++generation;
+        }
+        cv.notify_all();
+        work(f, c, count);
+        std::unique_lock<std::mutex> lk(m);
+        done_cv.wait(lk, [&] { return finished.load() == workers.size() + 1; });
+    }
+};
+
+static int hot_pool_threads() {
+    const char * e = getenv("LLAMA_HOT_READERS");
+    return e ? std::max(0, atoi(e)) : 3;
+}
+
+static void hot_parallel_for(size_t count, void * ctx, void (*fn)(void *, size_t)) {
+    static hot_pool pool(hot_pool_threads());
+    pool.run(count, ctx, fn);
+}
+
+// O_DIRECT needs the offset, the length and the buffer aligned to the logical
+// block; GGUF tensor data is only 32-byte aligned, so a direct read covers the
+// enclosing 4 KiB span and the slice is copied out.
+static bool hot_direct_reads() {
+    static const bool direct = getenv("LLAMA_HOT_DIRECT") && atoi(getenv("LLAMA_HOT_DIRECT")) != 0;
+    return direct;
+}
+
+static void hot_pread_exact(int fd, unsigned char * dst, size_t bytes, size_t offset) {
+    if (!hot_direct_reads()) {
+        size_t done = 0;
+        while (done < bytes) {
+            ssize_t n = pread(fd, dst + done, bytes - done, offset + done);
+            if (n < 0 && errno == EINTR) {
+                continue;
+            }
+            if (n <= 0) {
+                GGML_ABORT("hot-cache expert read failed: %s", strerror(errno));
+            }
+            done += n;
+        }
+        posix_fadvise(fd, offset, bytes, POSIX_FADV_DONTNEED);
+        return;
+    }
+    constexpr size_t     align = 4096;
+    const size_t         lo    = offset & ~(align - 1);
+    const size_t         hi    = (offset + bytes + align - 1) & ~(align - 1);
+    thread_local void *  buf   = nullptr;
+    thread_local size_t  cap   = 0;
+    if (cap < hi - lo) {
+        free(buf);
+        if (posix_memalign(&buf, align, hi - lo) != 0) {
+            GGML_ABORT("hot-cache staging allocation failed");
+        }
+        cap = hi - lo;
+    }
+    size_t done = 0;
+    while (done < hi - lo) {
+        ssize_t n = pread(fd, static_cast<unsigned char *>(buf) + done, hi - lo - done, lo + done);
+        if (n < 0 && errno == EINTR) {
+            continue;
+        }
+        if (n == 0 && done >= (offset - lo) + bytes) {
+            break; // the aligned span ran past the end of the file; the expert itself is complete
+        }
+        if (n <= 0) {
+            GGML_ABORT("hot-cache direct expert read failed: %s", strerror(errno));
+        }
+        done += n;
+    }
+    memcpy(dst, static_cast<unsigned char *>(buf) + (offset - lo), bytes);
+}
+#    endif
+
 
