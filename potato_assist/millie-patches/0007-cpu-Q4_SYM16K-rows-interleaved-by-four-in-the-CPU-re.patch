+#if defined(__ARM_NEON) && defined(__ARM_FEATURE_DOTPROD)
+// #185: Millie's dense Q4_SYM16K weights, rows interleaved by four. A decoded
+// token runs the lanes-are-rows GEMV on its column prepared once; more columns
+// run the q4_sym16k tiles on the interleave. Both are bit-identical to
+// ggml_vec_dot_q4_sym16k_q8_0, so moving a weight here changes no output.
+class q4_sym16k_x4_traits : public tensor_traits_base {
+    static constexpr int64_t CHUNK_COLS = 64;
+
+    static size_t col_size(const ggml_tensor * op) {
+        const int64_t ne10 = op->src[1]->ne[0];
+        return ggml_nrows(op->src[1]) == 1 ? ggml_q4_sym16k_x4_col_size(ne10) : ggml_row_size(GGML_TYPE_Q8_0, ne10);
+    }
+
+    bool work_size(int /* n_threads */, const struct ggml_tensor * op, size_t & size) override {
+        if (op->op != GGML_OP_MUL_MAT) {
+            return false;
+        }
+        size = col_size(op) * ggml_nrows(op->src[1]);
+        return true;
+    }
+
+    bool compute_forward(struct ggml_compute_params * params, struct ggml_tensor * op) override {
+        if (op->op != GGML_OP_MUL_MAT) {
+            return false;
+        }
+        const ggml_tensor * src0 = op->src[0];
+        const ggml_tensor * src1 = op->src[1];
+        ggml_tensor *       dst  = op;
+
+        GGML_TENSOR_BINARY_OP_LOCALS
+
+        GGML_ASSERT(src1->type == GGML_TYPE_F32 && nb10 == sizeof(float) && nb0 == sizeof(float));
+        GGML_ASSERT(ne02 == 1 && ne03 == 1 && ne0 == ne01);
+
+        const int     ith   = params->ith;
+        const int     nth   = params->nth;
+        const int64_t ncols = ne11 * ne12 * ne13;
+        const size_t  csize = col_size(op);
+        char *        wdata = static_cast<char *>(params->wdata);
+
+        auto col_of = [](const ggml_tensor * t, int64_t c) {
+            const int64_t i1 = c % t->ne[1], i2 = (c / t->ne[1]) % t->ne[2], i3 = c / (t->ne[1] * t->ne[2]);
+            return (char *) t->data + i1 * t->nb[1] + i2 * t->nb[2] + i3 * t->nb[3];
+        };
+
+        if (ncols == 1) {
+            if (ith == 0) {
+                ggml_q4_sym16k_x4_col((const float *) col_of(src1, 0), wdata, ne10);
+            }
+        } else {
+            const ggml_from_float_t from_float = ggml_get_type_traits_cpu(GGML_TYPE_Q8_0)->from_float;
+            for (int64_t c = ith; c < ncols; c += nth) {
+                from_float((const float *) col_of(src1, c), wdata + c * csize, ne10);
+            }
+        }
+        if (ith == 0) {
+            ggml_threadpool_chunk_set(params->threadpool, nth);
+        }
+        ggml_barrier(params->threadpool);
+
+        // About four chunks per thread, in whole groups of four rows.
+        const int64_t rows    = std::min<int64_t>(256, std::max<int64_t>(16, ne01 / (4 * nth))) / 4 * 4;
+        const int64_t nchunk0 = (ne01 + rows - 1) / rows;
+        const int64_t nchunk1 = ncols == 1 ? 1 : (ncols + CHUNK_COLS - 1) / CHUNK_COLS;
+        for (int64_t chunk = ith; chunk < nchunk0 * nchunk1; chunk = ggml_threadpool_chunk_add(params->threadpool, 1)) {
+            const int64_t r0 = (chunk % nchunk0) * rows;
+            const int64_t nr = std::min(rows, ne01 - r0);
+            const char *  x  = (const char *) src0->data + r0 * nb01;
+            if (ncols == 1) {
+                ggml_gemv_q4_sym16k_x4(ne00, nr, x, wdata, (float *) col_of(dst, 0) + r0);
+                continue;
+            }
+            const int64_t c0 = (chunk / nchunk0) * CHUNK_COLS;
+            const int     nc = (int) std::min(CHUNK_COLS, ncols - c0);
+            const void *  ys[CHUNK_COLS];
+            float *       ds[CHUNK_COLS];
+            for (int c = 0; c < nc; ++c) {
+                ys[c] = wdata + (c0 + c) * csize;
+                ds[c] = (float *) col_of(dst, c0 + c) + r0;
+            }
+            ggml_gemm_q4_sym16k_x4(ne00, nr, nc, x, ys, ds);
+        }
+        return true;
+    }
+
+    int repack(struct ggml_tensor * t, const void * data, size_t data_size) override {
+        GGML_ASSERT(t->type == GGML_TYPE_Q4_SYM16K && data_size == ggml_nbytes(t) && t->ne[1] % 4 == 0);
+        ggml_repack_q4_sym16k_x4(data, t->data, t->ne[1], t->ne[0]);
+        return 0;
+    }
+};
+#endif
+
 }  // namespace ggml::cpu::repack
 
 static const ggml::cpu::tensor_traits * ggml_repack_get_optimal_repack_type(const struct ggml_tensor * cur) {
+#if defined(__ARM_NEON) && defined(__ARM_FEATURE_DOTPROD)
+    static const ggml::cpu::repack::q4_sym16k_x4_traits q4_sym16k_x4;
+    if (cur->type == GGML_TYPE_Q4_SYM16K && ggml_n_dims(cur) == 2 && cur->ne[1] % 4 == 0 && ggml_q4_sym16k_x4_enabled()) {
+        return &q4_sym16k_x4;
+    }
+#endif
